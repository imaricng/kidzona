# =====================================================================
# Kidzona Nova Gradiška — primjer varijabli okruženja
# Kopiraj u `.env` i popuni stvarnim vrijednostima za produkciju.
# NIKADA ne spremaj stvarni `.env` u repozitorij.
# =====================================================================

# --- Baza podataka -----------------------------------------------------
# PostgreSQL (npr. Prisma Postgres na Vercelu)
DATABASE_URL="postgres://korisnik:lozinka@host:5432/postgres?sslmode=require"

# --- Aplikacija --------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Europe/Zagreb"

# --- Prijava (probna) -------------------------------------------
# Tajna za potpisivanje sesijskih kolačića (promijeni u produkciji!)
AUTH_SECRET="promijeni-me-u-produkciji-dugacka-tajna"
# Administrator — koristi ih `npm run db:admin` (lozinka barem 12 znakova)
ADMIN_EMAIL="admin@kidzona.hr"
ADMIN_PASSWORD=""

# --- Automatizacija (cron) --------------------------------------------
# Tajna za zaštitu /api/cron/reminders. U produkciji obvezna; pri razvoju prazno = dopušteno.
CRON_SECRET=""
# Bodovi vjernosti po završenoj proslavi
LOYALTY_POINTS_PER_PARTY="50"

# --- Plaćanje ---------------------------------------------------------
# Plaćanje putem interneta ZADANO JE ISKLJUČENO: rezervacija samo potvrđuje narudžbu,
# a plaća se uživo na dan proslave. Postavi na "true" za naplatu putem interneta.
ONLINE_PAYMENTS="false"

# --- Stripe (plaćanja, EUR) -------------------------------------------
# Vrijedi samo kad je ONLINE_PAYMENTS=true. Prazno = probni način (simulirano plaćanje).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Postotak akontacije pri potvrdi rezervacije (0–100)
DEPOSIT_PERCENT="30"

# --- Obavijesti (e-pošta / SMS) ---------------------------------------
# "console" = razvoj (poruke u konzoli). "resend" = prava e-pošta (Resend) + SMS (Twilio).
# "console" = poruke se samo zapisuju (ništa se ne šalje), "smtp" = Gmail, "resend" = Resend
NOTIFICATION_PROVIDER="console"
EMAIL_FROM="info@kidzona.hr"
# Primatelj obavijesti osoblju o novim rezervacijama
STAFF_EMAIL="kidzonang@gmail.com"
# Adresa za odgovore kupaca na automatske poruke
EMAIL_REPLY_TO="kidzonang@gmail.com"

# Slanje preko Gmail računa (NOTIFICATION_PROVIDER="smtp").
# SMTP_PASSWORD mora biti Google App Password (Google račun → Sigurnost →
# Potvrda u dva koraka → Lozinke za aplikacije). Lozinka računa NE radi.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="kidzonang@gmail.com"
SMTP_PASSWORD=""

# Kamo vodi „ostavite recenziju" iz poruke zahvale (Google poslovni profil).
# Ako je prazno, poveznica vodi na naslovnicu.
REVIEW_URL=""

RESEND_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Google Calendar --------------------------------------------------
# Potvrđene proslave upisuju se u kalendar igraonice preko servisnog računa.
# 1) Google Cloud → novi projekt → uključi Google Calendar API
# 2) Napravi servisni račun i preuzmi JSON ključ
# 3) U Google kalendaru podijeli kalendar s adresom servisnog računa
#    (client_email iz JSON-a) uz pravo „Mijenjanje događaja"
# GOOGLE_PRIVATE_KEY je private_key iz JSON-a, u navodnicima, s \n kao u datoteci.
GOOGLE_CALENDAR_ID="kidzonang@gmail.com"
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# --- Fiskalizacija (Hrvatska) -----------------------------------------
# Zadano je probni način (mock). Stvarni ovlašteni fiskalni servis priključuje se u
# src/lib/fiscalization/*. Vidi README, odjeljak "Fiskalizacija".
FISCALIZATION_PROVIDER="mock"
FISCAL_OIB=""               # OIB obveznika fiskalizacije
FISCAL_BUSINESS_SPACE="POSL1"
FISCAL_CASH_REGISTER="1"
FISCAL_CERT_PATH=""         # putanja do .p12 certifikata (FINA)
FISCAL_CERT_PASSWORD=""
