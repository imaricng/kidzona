# =====================================================================
# Kidzona Nova Gradiška — primjer varijabli okruženja
# Kopiraj u `.env` i popuni stvarnim vrijednostima za produkciju.
# NIKADA ne spremaj stvarni `.env` u repozitorij.
# =====================================================================

# --- Baza podataka -----------------------------------------------------
# Lokalni razvoj (zamjenska baza): SQLite
DATABASE_URL="file:./dev.db"
# Produkcija (Postgres) — shema je Postgres-kompatibilna:
# DATABASE_URL="postgresql://korisnik:lozinka@host:5432/kidzona?schema=public"

# --- Aplikacija --------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Europe/Zagreb"

# --- Prijava (probna) -------------------------------------------
# Tajna za potpisivanje sesijskih kolačića (promijeni u produkciji!)
AUTH_SECRET="promijeni-me-u-produkciji-dugacka-tajna"
# Probni administrator (stvara ga seed skripta)
ADMIN_EMAIL="admin@kidzona.hr"
ADMIN_PASSWORD="admin123"

# --- Automatizacija (cron) --------------------------------------------
# Tajna za zaštitu /api/cron/reminders. Prazno pri razvoju = dopušteno bez tajne.
CRON_SECRET=""
# Bodovi vjernosti po završenoj proslavi
LOYALTY_POINTS_PER_PARTY="50"

# --- Plaćanje ---------------------------------------------------------
# Plaćanje putem interneta ZADANO JE ISKLJUČENO: rezervacija samo potvrđuje narudžbu,
# a plaća se uživo na dan proslave. Postavi na "true" za naplatu putem interneta.
ONLINE_PAYMENTS="false"

# --- Stripe (plaćanja, EUR) -------------------------------------------
# Vrijedi samo kad je ONLINE_PAYMENTS=true. Prazno = probni način (simulirano plaćanje).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Postotak akontacije pri potvrdi rezervacije (0–100)
DEPOSIT_PERCENT="30"

# --- Obavijesti (e-pošta / SMS) ---------------------------------------
# "console" = razvoj (poruke u konzoli). "resend" = prava e-pošta (Resend) + SMS (Twilio).
NOTIFICATION_PROVIDER="console"
EMAIL_FROM="info@kidzona.hr"
# Primatelj obavijesti osoblju o novim rezervacijama
STAFF_EMAIL="kidzonang@gmail.com"
# Adresa za odgovore kupaca na automatske poruke
EMAIL_REPLY_TO="kidzonang@gmail.com"
RESEND_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Fiskalizacija (Hrvatska) -----------------------------------------
# Zadano je probni način (mock). Stvarni ovlašteni fiskalni servis priključuje se u
# src/lib/fiscalization/*. Vidi README, odjeljak "Fiskalizacija".
FISCALIZATION_PROVIDER="mock"
FISCAL_OIB=""               # OIB obveznika fiskalizacije
FISCAL_BUSINESS_SPACE="POSL1"
FISCAL_CASH_REGISTER="1"
FISCAL_CERT_PATH=""         # putanja do .p12 certifikata (FINA)
FISCAL_CERT_PASSWORD=""
